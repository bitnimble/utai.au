<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Microphone capture under the hardened runtime (tauri.conf.json
     bundle.macOS.hardenedRuntime, off while builds are ad-hoc signed); needed
     alongside NSMicrophoneUsageDescription (Info.plist) once it's turned on. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
