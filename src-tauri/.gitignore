# Generated by Cargo
# will have compiled files and executables
/target/
/gen/schemas

# Tauri mobile scaffolding (Gradle / Xcode projects). Regenerated from
# tauri.conf.json + tauri.android.conf.json by `bun run android:init`, then
# patched for Android TV by scripts/android-tv.ts; no manual edits live here,
# so it's regenerated rather than committed, same as /gen/schemas.
/gen/android
/gen/apple

# Staged by scripts/prepare-desktop-resources.mjs at build time (Python backend
# + the uv binary bundled into the app).
/resources/
