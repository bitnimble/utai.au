{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "utai.au",
  "version": "../package.json",
  "identifier": "au.utai",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build && bun run desktop:resources"
  },
  "app": {
    "windows": [
      {
        "title": "utai.au",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost blob: data: https: http:; connect-src 'self' ipc: http://ipc.localhost blob: data: https: http: wss: ws:; media-src 'self' blob: data: https: http:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/python/": "python/",
      "resources/bin/": "bin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1OTExNzBGOTc4NTM4ODIKUldTQ09JV1hEeGVSZFlEdkkzSGNveG55K3poak9RYnBOdGcwUzR3TDFCOUV6cnNaZzhvYU1IOVIK",
      "endpoints": ["https://github.com/bitnimble/utai.au/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
